<UserControl x:Class="WeScale.UserContr.Cartes.UsCo_Carta_Habilitats"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="220" Height="320">

        <Image Source="{Binding ImatgeCarta}" Stretch="Fill"/>

        <Grid Margin="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Imagen -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <Image Source="{Binding Imatge}" Stretch="UniformToFill"/>
            </Border>

            <!-- Header -->
            <StackPanel Grid.Row="1" Orientation="Horizontal">

                <TextBlock Text="{Binding Id}"
           FontWeight="Bold"
           Margin="0,0,5,0"/>

                <TextBlock Text="{Binding Nom}"
           FontWeight="Bold"/>

            </StackPanel>

            <!-- CONTENIDO -->
            <StackPanel Grid.Row="2">

                <TextBlock Text="Habilitat"
           FontWeight="Bold"
           Margin="0,0,0,5"/>

                <TextBlock Text="Cooldown:"/>
                <TextBlock Text="{Binding Cooldown}"/>

                <TextBlock Text="Tier:"
           Margin="0,5,0,0"/>

                <TextBlock Text="{Binding Tier}"/>

                <TextBlock Text="{Binding Descripcio}"
           TextWrapping="Wrap"
           Margin="0,5,0,0"/>

            </StackPanel>

            <!-- Botones -->
            <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

                <Button Content="✏" Margin="2"/>
                <Button Content="🗑" Margin="2"/>

            </StackPanel>

        </Grid>
    </Grid>
</UserControl>