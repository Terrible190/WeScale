<UserControl x:Class="WeScale.UserContr.Cartes.AfegirCarta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeScale.UserContr"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Top">
                <Image Height="223" Margin="20" />
                <StackPanel Orientation="Horizontal" >
                    <Label Content="Imatge" Margin="20 0 20 0"/>
                    <TextBox Text="Text..."></TextBox>
                </StackPanel>
                <Image HorizontalAlignment="Left" Height="74" Width="71" Margin="20" />

                <StackPanel Orientation="Horizontal" >
                    <Label Content="Icona" Margin="20 0 20 0"/>
                    <TextBox Text="Text..."  ></TextBox>
                </StackPanel>
                <Button Content="Calcelar" Width="70" Margin="20 30 10 10" Padding="10 5 10 5" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20 20 20 0" >
                    <Label Content="Nom:" Margin="0 0 20 0"/>
                    <TextBox Text="Text..."  ></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20 10 20 0" >
                    <Label Content="ID:" Margin="0 0 20 0"/>
                    <TextBox Text="Text..."  ></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20 10 20 0" >
                    <Label Content="Tipus:" Margin="0 0 20 0"/>
                    <ComboBox x:Name="Tipus" Width="100" SelectionChanged="Tipus_SelectionChanged"></ComboBox>
                </StackPanel>
                <ContentControl Height="185" x:Name="ContentArea" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <CheckBox Content="Sel·leccionable" Margin="20 10 20 0"></CheckBox>
                <Label Content="Descripcio: " Margin="20 10 20 0"></Label>
                <TextBox Height="80" Margin="20 10 20 0"></TextBox>

                <Button Content="Guardar" Width="70" Margin="20 10 10 10" Padding="10 5 10 5" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
