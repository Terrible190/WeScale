<UserControl x:Class="WeScale.UserContr.Cartes.UsCo_Carta_Personatge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WeScale.UserContr.Cartes"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="220">

    <Grid Width="220" Height="320">

        <!-- Fondo carta -->
        <Image Source="{Binding ImatgeCarta}" Stretch="Fill"/>

        <Grid Margin="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Imagen -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <Image Source="{Binding Imatge}" Stretch="UniformToFill"/>
            </Border>

            <!-- Header -->
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="{Binding Id}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Nom}" Margin="5,0"/>
            </StackPanel>

            <!-- Estadísticas -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="HP"/>
                <TextBlock Text="{Binding Hp}" Grid.Column="1"/>

                <TextBlock Text="ATK" Grid.Row="1"/>
                <TextBlock Text="{Binding AtacFisic}" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="DEF" Grid.Row="2"/>
                <TextBlock Text="{Binding DefensaFisica}" Grid.Row="2" Grid.Column="1"/>

            </Grid>

            <!-- Botones -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="✏" Margin="2"/>
                <Button Content="🗑" Margin="2"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>