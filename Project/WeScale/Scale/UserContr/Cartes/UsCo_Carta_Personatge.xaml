<UserControl x:Class="WeScale.UserContr.Cartes.UsCo_Carta_Personatge"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Border Width="220"
            Height="300"
            Margin="10"
            Background="#2E2E2E"
            BorderBrush="#777"
            BorderThickness="2"
            CornerRadius="10">

        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- IMATGE -->
            <Border Grid.Row="0"
                    CornerRadius="6"
                    ClipToBounds="True">

                <Image Stretch="UniformToFill"
                       Source="{Binding Imatge}"/>

            </Border>

            <!-- NOM -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Nom}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,6,0,6"/>

            <!-- STATS -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="HP"
                           Foreground="White"/>

                <TextBlock Text="{Binding HpBase}"
                           Grid.Column="1"
                           Foreground="White"/>

                <TextBlock Text="ATK"
                           Grid.Row="1"
                           Foreground="White"/>

                <TextBlock Text="{Binding DanyFisicBase}"
                           Grid.Row="1"
                           Grid.Column="1"
                           Foreground="White"/>

                <TextBlock Text="DEF"
                           Grid.Row="2"
                           Foreground="White"/>

                <TextBlock Text="{Binding DefensaFisicaBase}"
                           Grid.Row="2"
                           Grid.Column="1"
                           Foreground="White"/>

            </Grid>

            <!-- BOTONS -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" >

                <Button Width="25" Height="25" Margin="2" Click="BtnVisualitzar_Click">👁</Button>
                <Button Width="25" Height="25" Margin="2" Click="BtnEditar_Click">✏</Button>

            </StackPanel>
            <Button  Grid.Row="3" Width="25" Height="25" Margin="2"  HorizontalAlignment="Left" Click="BtnEliminar_Click">🗑</Button>


        </Grid>

    </Border>

</UserControl>