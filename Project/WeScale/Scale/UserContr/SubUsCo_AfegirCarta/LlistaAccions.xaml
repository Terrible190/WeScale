<Window x:Class="WeScale.UserContr.SubUsCo_AfegirCarta.LlistaAccions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Acció"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#2E2E2E" Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔍 BUSCADOR -->
        <TextBox x:Name="TxtBuscar"
                 Height="30"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center"
                 TextChanged="TxtBuscar_TextChanged"/>

        <!-- 📜 LISTA -->
        <ListView x:Name="LvAccions"
                  Grid.Row="1"
                  ItemsSource="{Binding AccionsFiltrades}"
                  MouseDoubleClick="LvAccions_DoubleClick">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#3A3A3A" Padding="8" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{Binding Nom}"
                                       Foreground="White"
                                       FontSize="14"
                                       Width="200"/>

                            <TextBlock Text="{Binding IdObjActiu}"
                                       Foreground="#AAAAAA"
                                       Margin="10,0,0,0"/>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <!-- BOTÓN -->
        <Button Grid.Row="2"
                Content="Seleccionar"
                Height="30"
                Margin="0,10,0,0"
                Click="BtnSeleccionar_Click"/>

    </Grid>
</Window>