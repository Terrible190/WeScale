<Window x:Class="WeScale.UserContr.SubUsCo_AfegirCarta.LlistaEfectes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeScale.UserContr.SubUsCo_AfegirCarta"
        xmlns:conv="clr-namespace:WeScale.Model.Converter"
        mc:Ignorable="d"
        Title="LlistaEfectes" Height="450" Width="800">
    <Window.Resources>
        <conv:EfecteModEstadisticaConverter x:Key="EfecteConverter"/>
    </Window.Resources>
    <Grid Background="#2E2E2E" Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔍 BUSCADOR -->


        <!-- 📜 LISTA -->
        <ListView x:Name="ListaEfectes"
              Grid.Row="1"
              ItemsSource="{Binding EfectesFiltrats}"
              Background="Transparent"
              BorderThickness="0"
              MouseDoubleClick="ListaEfectes_DoubleClick">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Border Background="#3A3A3A"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8"
                        BorderBrush="#555"
                        BorderThickness="1">

                        <StackPanel>

                            <!-- NOM -->
                            <TextBlock Text="{Binding Descripcio}"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                            <ItemsControl ItemsSource="{Binding EfecteModEstadisticas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock 
                                             Text="{Binding Converter={StaticResource EfecteConverter}}"
                                             Foreground="#FFD700"
                                             FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <!-- BOTÓN -->
        <Button Grid.Row="2"
            Content="Seleccionar"
            Height="30"
            Margin="0,10,0,0"
            Click="BtnSeleccionar_Click"/>

    </Grid>
</Window>
