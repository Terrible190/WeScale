<UserControl x:Class="WeScale.UserContr.SubUsCo_AfegirCarta.InventariPersonatges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#2E2E2E" Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TABS -->
        <TabControl Grid.Row="0" Height="30" Margin="0,0,0,8">
            <TabItem Header="Set"/>
            <TabItem Header="General"/>
            <TabItem Header="Estadístiques"/>
        </TabControl>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HABILITATS -->
            <TextBlock Grid.Row="0"
                       FontSize="14"
                       Foreground="White"
                       Margin="0,0,0,5"
                       Text="Habilitats"/>

            <ListView Grid.Row="1"
                      Margin="0,0,8,8"
                      ItemsSource="{Binding Habilitats}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A3A3A" Padding="5" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock Text="{Binding Nom}" 
                                           Foreground="White"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding IdAccio}" 
                                           Foreground="#BBBBBB"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- OBJECTES -->
            <TextBlock Grid.Row="0" Grid.Column="1"
                       FontSize="14"
                       Foreground="White"
                       Margin="0,0,0,5"
                       Text="Objectes"/>

            <ListView Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding PersonatgeAcciosObjectes}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A3A3A" Padding="5" Margin="3">
                            <TextBlock Text="{Binding Accio.Nom}" 
                                       Foreground="White"
                                       FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ARMES -->
            <TextBlock Grid.Row="2"
                       FontSize="14"
                       Foreground="White"
                       Margin="0,0,0,5"
                       Text="Armes"/>

            <ListView Grid.Row="3"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding PersonatgeAcciosArmes}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A3A3A" Padding="5" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Nom}"
                                           Foreground="White"
                                           FontSize="12"
                                           Width="120"/>
                                <CheckBox IsChecked="{Binding Equipat}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>

        <!-- BOTONES -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">

            <Button Content="Afegir" Width="70" Margin="0,0,5,0"/>
            <Button Content="Guardar" Width="70"/>

        </StackPanel>

    </Grid>
</UserControl>