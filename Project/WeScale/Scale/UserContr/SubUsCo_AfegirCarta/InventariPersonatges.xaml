<UserControl x:Class="WeScale.UserContr.SubUsCo_AfegirCarta.InventariPersonatges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WeScale.UserContr.SubUsCo_AfegirCarta">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- TABS -->
        <!-- ========================= -->
        <TabControl Grid.Row="0" Height="30" Margin="0,0,0,8">
            <TabItem Header="Set"/>
            <TabItem Header="General"/>
            <TabItem Header="Estadístiques"/>
        </TabControl>

        <!-- ========================= -->
        <!-- CONTENIDO -->
        <!-- ========================= -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================= -->
            <!-- HABILITATS -->
            <!-- ========================= -->
            <Label Grid.Row="0"
                   Style="{StaticResource RPGLabelStyle}"
                   Content="Habilitats"
                   Margin="0,0,0,5"/>

            <ListView Grid.Row="1"
                      Margin="0,0,8,8"
                      ItemsSource="{Binding Habilitats}"
                      ItemContainerStyle="{StaticResource RPGListViewItemStyle}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A3A3A" Padding="5" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock Text="{Binding Nom}" 
                                           Foreground="White"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding IdAccio}" 
                                           Foreground="#BBBBBB"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ========================= -->
            <!-- OBJECTES -->
            <!-- ========================= -->
            <Label Grid.Row="0" Grid.Column="1"
                   Style="{StaticResource RPGLabelStyle}"
                   Content="Objectes"
                   Margin="0,0,0,5"/>

            <ListView Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding PersonatgeAcciosObjectes}"
                      ItemContainerStyle="{StaticResource RPGListViewItemStyle}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A3A3A" Padding="5" Margin="3">
                            <TextBlock Text="{Binding Accio.Nom}" 
                                       Foreground="White"
                                       FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ========================= -->
            <!-- ARMES -->
            <!-- ========================= -->
            <Label Grid.Row="2"
                   Style="{StaticResource RPGLabelStyle}"
                   Content="Armes"
                   Margin="0,0,0,5"/>

            <ListView Grid.Row="3"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding PersonatgeAcciosArmes}"
                      ItemContainerStyle="{StaticResource RPGListViewItemStyle}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A3A3A" Padding="5" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Nom}"
                                           Foreground="White"
                                           FontSize="12"
                                           Width="120"/>
                                <CheckBox IsChecked="{Binding Equipat}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>

        <!-- ========================= -->
        <!-- BOTONES -->
        <!-- ========================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">

            <Button Content="Afegir"
                    Style="{StaticResource RPGImageButtonStyle1}"
                     Margin="0,0,5,0"/>
            <Button Content="Guardar"
                    Style="{StaticResource RPGImageButtonStyle2}"
                    />
        </StackPanel>

    </Grid>
</UserControl>