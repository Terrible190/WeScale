<UserControl x:Class="WeScale.UserContr.SubUsCo_AfegirCarta.InventariPersonatges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#2E2E2E" Margin="8">

        <TabControl>

            <!-- ===================== -->
            <!-- HABILITATS -->
            <!-- ===================== -->
            <TabItem Header="Habilitats">
                <StackPanel>
                    <ListView ItemsSource="{Binding Habilitats}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3A3A3A" Padding="5" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Nom}" 
                                                   Foreground="White"
                                                   Width="120"/>

                                        <Button Content="❌"
                                                Tag="{Binding}"
                                                Click="BtnEliminar_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Content="Afegir Habilitat"
                            Click="BtnAfegirHabilitat_Click"
                            Margin="0,5,0,0"/>

                </StackPanel>
            </TabItem>

            <!-- ===================== -->
            <!-- OBJECTES -->
            <!-- ===================== -->
            <TabItem Header="Objectes">
                <StackPanel>

                    <ListView ItemsSource="{Binding Objectes}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3A3A3A" Padding="5" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Nom}" 
                                                   Foreground="White"
                                                   Width="120"/>

                                        <Button Content="❌"
                                                Tag="{Binding}"
                                                Click="BtnEliminar_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Content="Afegir Objecte"
                            Click="BtnAfegirObjecte_Click"
                            Margin="0,5,0,0"/>

                </StackPanel>
            </TabItem>

            <!-- ===================== -->
            <!-- ARMES -->
            <!-- ===================== -->
            <TabItem Header="Armes">
                <StackPanel>

                    <ListView ItemsSource="{Binding Armes}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3A3A3A" Padding="5" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Nom}" 
                                                   Foreground="White"
                                                   Width="120"/>

                                        <Button Content="❌"
                                                Tag="{Binding}"
                                                Click="BtnEliminar_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Content="Afegir Arma"
                            Click="BtnAfegirArma_Click"
                            Margin="0,5,0,0"/>

                </StackPanel>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>