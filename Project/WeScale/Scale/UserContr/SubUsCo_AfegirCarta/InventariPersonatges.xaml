<UserControl x:Class="WeScale.UserContr.SubUsCo_AfegirCarta.InventariPersonatges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeScale.UserContr.SubUsCo_AfegirCarta"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
<Grid Background="#2E2E2E" Margin="15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TABS -->
                <TabControl Grid.Row="0" Height="40" Margin="0,0,0,15">

                    <TabItem Header="Set"/>
                    <TabItem Header="General"/>
                    <TabItem Header="Estadístiques"/>

                </TabControl>

                <!-- CONTINGUT -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HABILITATS -->
                    <TextBlock Grid.Row="0"
FontSize="18"
Foreground="White"
Margin="0,0,0,10"
Text="Habilitats"/>

                    <StackPanel Grid.Row="1" Margin="0,0,20,20">

                        <Border Background="#3A3A3A" Height="60" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#555" Width="40" Height="40"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Habilitat 1" Foreground="White"/>
                                    <TextBlock Text="ID 1" Foreground="#BBBBBB" FontSize="11"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <Border Background="#3A3A3A" Height="60">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#555" Width="40" Height="40"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Habilitat 2" Foreground="White"/>
                                    <TextBlock Text="ID 2" Foreground="#BBBBBB" FontSize="11"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- OBJECTES -->
                    <TextBlock Grid.Row="0" Grid.Column="1"
FontSize="18"
Foreground="White"
Margin="0,0,0,10"
Text="Objectes"/>

                    <UniformGrid Grid.Row="1"
Grid.Column="1"
Columns="2"
Margin="0,0,0,20">

                        <Border Background="#3A3A3A" Margin="5" Height="70"/>
                        <Border Background="#3A3A3A" Margin="5" Height="70"/>
                        <Border Background="#3A3A3A" Margin="5" Height="70"/>
                        <Border Background="#3A3A3A" Margin="5" Height="70"/>

                    </UniformGrid>

                    <!-- ARMES -->
                    <TextBlock Grid.Row="2"
FontSize="18"
Foreground="White"
Margin="0,0,0,10"
Text="Armes"/>

                    <Border Grid.Row="3"
Background="#3A3A3A"
Height="60"
Margin="0,0,20,0">

                        <Grid Margin="10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#555" Width="40" Height="40"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Arma 1" Foreground="White"/>
                                <TextBlock Text="ID 1" Foreground="#BBBBBB" FontSize="11"/>
                            </StackPanel>

                            <CheckBox Grid.Column="2"
Content="Equipat"
Foreground="White"
VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </Grid>

                <!-- BOTONS -->
                <Grid Grid.Row="2" Margin="0,15,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="Cancelar"
Width="90"
Margin="0,0,10,0"/>

                        <Button Content="Eliminar"
Width="90"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <Button Content="Afegir"
Width="90"
Margin="0,0,10,0"/>

                        <Button Content="Guardar"
Width="90"/>

                    </StackPanel>

                </Grid>

    </Grid>
</UserControl>
