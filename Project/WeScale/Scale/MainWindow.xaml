<Window x:Class="WeScale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:usco="clr-namespace:WeScale.UserContr"
        xmlns:cartes="clr-namespace:WeScale.UserContr.Cartes"
        xmlns:models="clr-namespace:BD.Models;assembly=BD"
        xmlns:local="clr-namespace:WeScale"        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1135">


    <Window.Resources>


        <Style x:Key="BigCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Grid Width="26" Height="26" Margin="0,0,8,0">
                                <Border x:Name="Box"
                                BorderThickness="2"
                                BorderBrush="Black"
                                Background="White"/>

                                <Path x:Name="CheckMark"
                              Visibility="Collapsed"
                              Stroke="Green"
                              StrokeThickness="3"
                              Data="M 2 12 L 8 18 L 18 4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                            </Grid>

                            <ContentPresenter VerticalAlignment="Center"/>

                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>

                                <Setter TargetName="Box" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PersonatgeTemplate">
            <cartes:UsCo_Carta_Personatge/>
        </DataTemplate>

        <DataTemplate x:Key="ArmaTemplate">
            <cartes:UsCo_Carta_Arma/>
        </DataTemplate>

        <DataTemplate x:Key="HabilitatTemplate">
            <cartes:UsCo_Carta_Habilitats/>
        </DataTemplate>

        <DataTemplate x:Key="ObjecteTemplate">
            <cartes:UsCo_Carta_Objecte/>
        </DataTemplate>

        <local:CartaTemplateSelector x:Key="CartaSelector"
                                 PersonatgeTemplate="{StaticResource PersonatgeTemplate}"
                                 ArmaTemplate="{StaticResource ArmaTemplate}"
                                 HabilitatTemplate="{StaticResource HabilitatTemplate}"
                                 ObjecteTemplate="{StaticResource ObjecteTemplate}"/>

    </Window.Resources>





    <Grid Margin="0,0,10,0"  >

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 IMATGE FONS DIFUMINADA -->
        <Image Source="/Imatges/ChatGPT Image 23 feb 2026, 20_32_19.png"
           Stretch="UniformToFill"
           Grid.RowSpan="2"
           Panel.ZIndex="0">
            <Image.Effect>
                <BlurEffect Radius="12"/>
            </Image.Effect>
        </Image>
        <Grid Grid.Row="0"  VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>

            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Border 
                Margin="20"
                CornerRadius="15"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Height="30"
                VerticalAlignment="Top">
                    <Grid  VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="37*"/>
                            <ColumnDefinition Width="157*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock 
                            Text="🔍"
                            FontSize="18"
                            VerticalAlignment="Center"
                            Margin="10,0,10,0"/>


                        <TextBox 
                            x:Name="TxtBuscar"
                            Grid.Column="1"
                            BorderThickness="0"
                            Background="Transparent"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            Foreground="#333333"
                            Padding="5"
                            TextChanged="BuscarCanvis" Grid.ColumnSpan="2"
                        />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">

                <!-- 🔥 BACKGROUND -->
                <Border Background="#666B2B2B" CornerRadius="10" Margin="15" Height="60" VerticalAlignment="Top"/>

                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
                            Height="90"
            Margin="0,0,0,30">

                    <!-- PERSONATGE -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
          Margin="30,0"
          VerticalContentAlignment="Center"
          x:Name="ChkPersonatges"
          Checked="FiltreCanvis"
          Unchecked="FiltreCanvis">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/personatges-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                    <!-- OBJECTES -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
          Margin="30,0"
          VerticalContentAlignment="Center"
          x:Name="ChkObjectes"
          Checked="FiltreCanvis"
          Unchecked="FiltreCanvis">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/objectes-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                    <!-- HABILITATS -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
          Margin="30,0"
          VerticalContentAlignment="Center"
          x:Name="ChkHabilitats"
          Checked="FiltreCanvis"
          Unchecked="FiltreCanvis">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/habilitats-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                    <!-- ARMES -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
          Margin="30,0"
          VerticalContentAlignment="Center"
          x:Name="ChkArmes"
          Checked="FiltreCanvis"
          Unchecked="FiltreCanvis">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/armes-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                </StackPanel>
            </Grid>

        </Grid>
        <Grid Grid.Row="1">
            <Border Background="#666B2B2B"
                    CornerRadius="10"
                    Margin="15"/>
            <ListView ItemsSource="{Binding Cartes}"
          ItemTemplateSelector="{StaticResource CartaSelector}"
          ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

            </ListView>
        </Grid>
    </Grid>
</Window>
