<Window x:Class="WeScale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeScale"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1135">

    <Window.Resources>
        <Style x:Key="BigCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Grid Width="26" Height="26" Margin="0,0,8,0">
                                <Border x:Name="Box"
                                BorderThickness="2"
                                BorderBrush="Black"
                                Background="White"/>

                                <Path x:Name="CheckMark"
                              Visibility="Collapsed"
                              Stroke="Green"
                              StrokeThickness="3"
                              Data="M 2 12 L 8 18 L 18 4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                            </Grid>

                            <ContentPresenter VerticalAlignment="Center"/>

                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                
                                <Setter TargetName="Box" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>





    <Grid Margin="0,0,10,0"  >

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 IMATGE FONS DIFUMINADA -->
        <Image Source="/Imatges/ChatGPT Image 23 feb 2026, 20_32_19.png"
           Stretch="UniformToFill"
           Grid.RowSpan="2"
           Panel.ZIndex="0">
            <Image.Effect>
                <BlurEffect Radius="12"/>
            </Image.Effect>
        </Image>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>

            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Border 
                Margin="20"
                CornerRadius="15"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Height="30"
                VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock 
                            Text="🔍"
                            FontSize="18"
                            VerticalAlignment="Center"
                            Margin="10,0"/>


                        <TextBox 
                            Grid.Column="1"
                            BorderThickness="0"
                            Background="Transparent"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            Foreground="#333333"
                            Padding="5"
                            Text="Buscar..."
                            />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="0">

                <!-- 🔥 BACKGROUND -->
                <Border Background="#666B2B2B" CornerRadius="10" Margin="15" Height="60" VerticalAlignment="Top"/>

                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
                            Height="90"
            Margin="0,0,0,30">

                    <!-- PERSONATGE -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
              Margin="30,0"
              VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/personatges-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                    <!-- OBJECTES -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
              Margin="30,0"
              VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/objectes-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                    <!-- HABILITATS -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
              Margin="30,0"
              VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/habilitats-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                    <!-- ARMES -->
                    <CheckBox Style="{StaticResource BigCheckBoxStyle}"
              Margin="30,0"
              VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Imatges/armes-removebg-preview.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,10,0"/>

                        </StackPanel>
                    </CheckBox>

                </StackPanel>
            </Grid>

        </Grid>
        <Grid Grid.Row="1">
            <Border Background="#666B2B2B" CornerRadius="10" Margin="15"/>
        </Grid>
    </Grid>
</Window>
