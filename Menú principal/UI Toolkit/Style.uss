.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(26, 26, 26);
    background-image: url("project://database/Assets/rpgimage.png?fileID=2800000&guid=5061edd28e0b90c43b7863ed18cb0181&type=3#rpgimage");
}

.frame {
    width: 520px;
    padding: 24px;
    background-color: rgba(20, 16, 10, 0.92);
    border-width: 6px;
    border-color: rgb(194, 163, 107);
    border-radius: 6px;
    box-shadow: 0 0 0 2px rgb(58, 47, 28), 0 0 20px rgba(0, 0, 0, 0.8);
}

.title {
    font-size: 32px;
    unity-font-style: bold;
    color: rgb(245, 215, 122);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    text-shadow: 2px 2px 0;
}

.menu {
    flex-direction: column;
    gap: 10px;
}

.rpg-button {
    height: 48px;
    margin-top: 6px;
    margin-bottom: 6px;
    background-color: rgb(43, 33, 22);
    border-width: 3px;
    border-color: rgb(176, 138, 74);
    color: rgb(243, 230, 194);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 4px;
}

.rpg-button:hover {
    background-color: rgb(58, 44, 29);
    border-color: rgb(240, 210, 138);
    color: rgb(255, 243, 196);
}

.rpg-button:active {
    background-color: rgb(29, 22, 15);
    border-color: rgb(139, 106, 51);
}
